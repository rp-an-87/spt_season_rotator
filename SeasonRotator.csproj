<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SeasonRotator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.1</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)-$(Version)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6"/>
    <PackageReference Include="SPTushonka.DI" Version="4.1.6"/>
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6"/>
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.2" ExcludeAssets="runtime"/>
  </ItemGroup>


  <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="'$(SPTPath)' != ''">
    <PropertyGroup>
      <ModsDirectoryPath>$(SPTPath)\user\mods\$(MSBuildProjectName)</ModsDirectoryPath>
    </PropertyGroup>
    <Message Importance="high" Text="Copying mods to $(ModsDirectoryPath)" />
    <ItemGroup>
      <FilesToCopy Include="$(OutputPath)$(TargetName)$(TargetExt)" />
      <FilesToCopy Include="$(OutputPath)$(TargetName).pdb" />
    </ItemGroup>
    <!-- .orig = the first DLL ever replaced (never overwritten); .bak = the previous deploy. A loaded DLL can be renamed but not overwritten, so the old one is moved aside first. -->
    <MakeDir Directories="$(ModsDirectoryPath)" />
    <Copy SourceFiles="$(ModsDirectoryPath)\$(TargetName)$(TargetExt)" DestinationFiles="$(ModsDirectoryPath)\$(TargetName)$(TargetExt).orig" Condition="Exists('$(ModsDirectoryPath)\$(TargetName)$(TargetExt)') And !Exists('$(ModsDirectoryPath)\$(TargetName)$(TargetExt).orig')" />
    <Delete Files="$(ModsDirectoryPath)\$(TargetName)$(TargetExt).bak" ContinueOnError="true" />
    <Move SourceFiles="$(ModsDirectoryPath)\$(TargetName)$(TargetExt)" DestinationFiles="$(ModsDirectoryPath)\$(TargetName)$(TargetExt).bak" Condition="Exists('$(ModsDirectoryPath)\$(TargetName)$(TargetExt)')" />
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ModsDirectoryPath)" ContinueOnError="false" />
    <Message Text="Files copied" />
  </Target>

</Project>
